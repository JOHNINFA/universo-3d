<!doctype html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Universo de Mundos</title>
<style>
html,body{margin:0;height:100%;background:#02030a;overflow:hidden;font-family:system-ui,sans-serif;color:#e8eefc}
canvas{display:block;touch-action:none}
#hud{position:fixed;left:16px;top:14px;pointer-events:none}
#hud h1{margin:0;font-size:20px;font-weight:600;letter-spacing:.5px}
#ruta{margin:5px 0 0;font-size:13px;color:#9fc2ff}
#ayuda{margin:3px 0 0;font-size:12px;opacity:.65}
.btn{position:fixed;left:16px;border:1px solid #7db0ff;background:#0b1224cc;color:#e8eefc;border-radius:20px;padding:8px 16px;font-size:13px;cursor:pointer}
.btn:hover{border-color:#bcd6ff;background:#13204acc}
#atras{top:92px;display:none}
#entrar{bottom:16px;display:none}
#chars{position:fixed;left:50%;bottom:14px;transform:translateX(-50%);display:none;gap:8px;flex-wrap:wrap;justify-content:center;max-width:92vw}
#chars button{border:1px solid #ffffff30;background:#0b1224cc;color:#e8eefc;border-radius:20px;padding:7px 14px;font-size:13px;cursor:pointer}
#chars button.on{background:#3b82f6;border-color:#7db0ff}
#card{position:fixed;right:16px;top:14px;width:240px;background:#0b1224cc;border:1px solid #ffffff25;border-radius:14px;padding:12px 14px;font-size:13px;line-height:1.35;display:none}
#card b{font-size:16px}
#etiquetas{position:fixed;inset:0;pointer-events:none;display:none}
.etq{position:absolute;left:0;top:0;pointer-events:auto;cursor:pointer;font-size:13px;color:#dfe9ff;background:#0b1224aa;border:1px solid #ffffff30;border-radius:12px;padding:2px 9px;white-space:nowrap;text-shadow:0 1px 2px #000}
.etq:hover{border-color:#7db0ff;background:#13204acc}
.etq small{color:#7ee0a0;margin-left:4px}
#burbujas{position:fixed;inset:0;pointer-events:none;overflow:hidden}
.bub{position:absolute;left:0;top:0;display:none;max-width:210px;background:#fffffff0;color:#1b2233;font-size:13px;line-height:1.25;border-radius:12px;padding:6px 10px;box-shadow:0 2px 8px #0006}
</style></head><body>
<div id="hud"><h1>Universo de Mundos</h1><p id="ruta"></p><p id="ayuda"></p></div>
<button class="btn" id="atras">← Volver</button>
<button class="btn" id="entrar">Entrar al mundo</button>
<div id="etiquetas"></div><div id="burbujas"></div>
<div id="card"></div><div id="chars"></div>
<script type="importmap">{"imports":{"three":"./node_modules/three/build/three.module.js"}}</script>
<script type="module" src="main.js"></script>
</body></html>
